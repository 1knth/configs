# This is the configuration file for Ghostty.
term = xterm-ghostty
working-directory = home
window-inherit-working-directory = false
# laptop w/ gaps
font-size = 18.5
# 1920x1080 24' w/ gaps
# font-size = 20
# font-family = "JetBrains Mono"
font-family = "Iosevka"
# font-family = "Symbols Nerd Font"
font-style-bold = Heavy
font-style-bold-italic = Heavy Italic
window-padding-x = 10
window-padding-y = 0
window-padding-balance = true
# cursor-style = block
# background-blur-radius = 20
background-opacity = 0.7
background-blur = 10
# background = #13182d
#black
# background = #0f0f0f
# emacs editor
background = #181616
# emacs status 
# background= #282727
# background = #242424
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f37799
palette = 10=#89d88b
palette = 11=#ebd391
palette = 12=#74a8fc
palette = 13=#f2aede
palette = 14=#6bd7ca
palette = 15=#bac2de
foreground = #cdd6f4
cursor-color = #3c6dad
cursor-text = #fcfcfc
# custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = false
selection-background = #585b70
selection-foreground = #cdd6f4
adjust-cell-height = 0%
adjust-cell-width = 5%
mouse-scroll-multiplier = 1
# resize-overlay = never
# window-padding-color = extend
# Word navigation
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf
macos-titlebar-style = transparent
# macos-titlebar-style = native
# title = " "
# macos-titlebar-proxy-icon = hidden
# Word selection - Shift+Alt
keybind = shift+left=text:\x1bB
keybind = shift+right=text:\x1bF

# Buffer cycling
keybind = ctrl+tab=text:\x1b]t
keybind = ctrl+shift+tab=text:\x1b]T

# tmux
# tmux window switching with Cmd+number
keybind = cmd+digit_1=text:\x1b1
keybind = cmd+digit_2=text:\x1b2
keybind = cmd+digit_3=text:\x1b3
keybind = cmd+digit_4=text:\x1b4
keybind = cmd+digit_5=text:\x1b5
keybind = cmd+digit_6=text:\x1b6
keybind = cmd+digit_7=text:\x1b7
keybind = cmd+digit_8=text:\x1b8
keybind = cmd+digit_9=text:\x1b9
