#!/bin/bash

# Load colors and set directory
source "$CONFIG_DIR/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top \
  height=36 \
  blur_radius=60 \
  color=0x00000000
# color=0xd0ffffff

##### Changing Defaults #####
# Ensure "Hack Nerd Font" is installed.
# If icons still don't show, check Font Book for the exact name.
default=(
  padding_left=3
  padding_right=3
  # icon.font="Hack Nerd Font:Regular:16.0"
  label.font="SF Pro:Semibold:16.0"
  # label.font="Iosevka:Semibold:20.0"
  # label.font="JetBrains Nerd Font:Semibold:15.0"
  icon.color=$GLASS_TEXT
  label.color=$GLASS_TEXT
  icon.padding_left=9.8
  icon.padding_right=0
  label.padding_left=8
  label.padding_right=10
  # background.color=0x40000000
  background.color=0x00eeeeee
  # background.color=0x552a2e33
  background.corner_radius=8
  background.height=26
  background.border_width=1
  background.border_color=0x002a2e33
  background.blur_radius=30
)
sketchybar --default "${default[@]}"

##### Left Items #####

sketchybar --add event aerospace_workspace_change

AEROSPACE_WORKSPACES=$(aerospace list-workspaces --all 2>/dev/null || echo "123456")

for ws in $AEROSPACE_WORKSPACES; do
  sketchybar --add item aerospace.$ws left \
    --set aerospace.$ws \
    label="$ws" \
    icon.drawing=off \
    label.color=$INACTIVE_WORKSPACE \
    background.drawing=off \
    padding_left=0 \
    padding_right=0 \
    script="$PLUGIN_DIR/aerospace_workspace.sh $ws" \
    --subscribe aerospace.$ws aerospace_workspace_change
done

sketchybar --trigger aerospace_workspace_change

sketchybar --add item separator left \
  --set separator label="❯" \
  label.color=0x60ffffff \
  background.drawing=off \
  padding_left=0 \
  padding_right=0 \
  icon.drawing=off

